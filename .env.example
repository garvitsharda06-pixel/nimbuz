# Copy to .env (never commit .env). Secrets are read only from here and never logged.

# Upstox: read-only Analytics Token for market data (Market Data + Realtime & Streaming APIs).
# Generate in the Upstox developer console. See docs/DECISIONS.md D-010.
UPSTOX_ANALYTICS_TOKEN=

# Telegram alerts to YOUR OWN chat only (personal use; sharing calls needs SEBI RA registration).
# 1) create a bot with @BotFather, 2) message it once, 3) get your chat id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
